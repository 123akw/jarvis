{
  "name": "jarvis-examples",
  "interface": {
    "displayName": "贾维斯示例插件源"
  },
  "plugins": [
    {
      "name": "festival-greetings",
      "source": {
        "source": "local",
        "path": "./plugins/festival-greetings"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Lifestyle"
    },
