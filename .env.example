# 复制为 .env 并填入真实 key（.env 已被 gitignore，不会进仓库）
DEEPSEEK_API_KEY=sk-你的key
JARVIS_BASE_URL=https://api.deepseek.com
JARVIS_MODEL=deepseek-v4-flash
# 实时公开网页搜索（必需）：https://app.tavily.com/home
TAVILY_API_KEY=tvly-你的key
# 结构化电竞比分（可选）：未配置会自动回退 Tavily
# PANDASCORE_TOKEN=你的token
# 可选：备忘与记忆数据库的存放目录，默认为项目根的 data/
# JARVIS_DATA_DIR=/path/to/data
