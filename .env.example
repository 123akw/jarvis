# 复制为 .env 后，先填完以下留空值再首次启动（.env 已被 gitignore）
DEEPSEEK_API_KEY=
JARVIS_PROVIDER=deepseek
JARVIS_API_KEY=
JARVIS_BASE_URL=https://api.deepseek.com
JARVIS_MODEL=deepseek-v4-flash
# 首次启动只会用这三项创建唯一 Owner；口令与 secret 必须使用不同的强随机值。
# SESSION_SECRET 至少 32 字节，例如 openssl rand -hex 32 的输出。
# 网页上新建用户/改口令要求：至少 8 位、不能是常见弱口令、不能是用户名或用户名加数字。
JARVIS_ADMIN_USERNAME=
JARVIS_ADMIN_PASSWORD=
JARVIS_SESSION_SECRET=
# 开启网页/桌面 Provider 设置写入时，两项必须同时配置；主密钥不得提交，丢失后已存的 Key 无法解密。
# 主密钥必须是 URL-safe Base64 编码的 32 字节（不是 hex），生成：
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
JARVIS_SETTINGS_WRITE_ENABLED=false
JARVIS_SECRETS_KEY=
# 免费优先的联网搜索与正文提取回退链（逗号分隔，不能重复）
JARVIS_SEARCH_BACKENDS=searxng,ddgs,tavily
JARVIS_EXTRACT_BACKENDS=trafilatura,playwright
# 可选：仓库 Compose 的本地 SearXNG；未启动/未配置时自动回退 DDGS
# SEARXNG_BASE_URL=http://127.0.0.1:18888
# 可选的实时公开网页搜索：https://app.tavily.com/home
# TAVILY_API_KEY=<optional-tavily-key>
# 结构化电竞比分（可选）：未配置会自动回退默认网页搜索链
# PANDASCORE_TOKEN=<optional-pandascore-token>
# 语音通话（可选）：TTS 用 MiniMax，服务端流式识别用阿里百炼。
# 两个 key 都缺时语音功能自动降级（浏览器识别 + 纯文字），不影响文字聊天。
# MINIMAX_API_KEY=<optional-minimax-key>            # https://platform.minimaxi.com/
# DASHSCOPE_API_KEY=<optional-dashscope-key>        # https://bailian.console.aliyun.com/
# 可选：语音答复音色与模型（默认 male-qn-qingse / speech-2.8-turbo；首包明显快于旧 speech-02-turbo）
# MINIMAX_TTS_VOICE=male-qn-qingse
# MINIMAX_TTS_MODEL=speech-2.8-turbo
# MINIMAX_TTS_SPEED=1.0
# 可选：语音通话判停静音阈值（毫秒，200–6000，默认 500）
# DASHSCOPE_ASR_MAX_SILENCE_MS=500
# 微信语音消息识别模型（可选，默认 qwen3-asr-flash，同用 DASHSCOPE_API_KEY）
# JARVIS_DASHSCOPE_ASR_MODEL=qwen3-asr-flash
# 微信语音回复最多朗读的字数（默认 280）；iLink 语音报文结构实测前，发送侧的类型号/字段名可在此覆盖
# JARVIS_WECHAT_VOICE_MAX_REPLY_CHARS=280
# JARVIS_WECHAT_VOICE_SEND_ITEM_TYPE=34
# JARVIS_WECHAT_VOICE_SEND_ITEM_KEY=voice_item
# JARVIS_WECHAT_VOICE_SEND_DATA_KEY=voice_data
# JARVIS_WECHAT_VOICE_SEND_FORMAT=silk
# 可选：群聊里 @ 贾维斯的名字（默认「贾维斯」，被 @ 才会在群里应答）
# JARVIS_WECHAT_GROUP_NAME=贾维斯
# 飞书机器人（可选）：企业自建应用凭证，开发者后台「凭证与基础信息」获取；两项都填才启用。
# 走长连接（WebSocket）收事件，服务器无需公网回调地址。后台配置清单见 docs/channels.md「飞书机器人」，
# 凭证到位后先跑：.venv/bin/python scripts/feishu_smoke.py --live
# FEISHU_APP_ID=<cli_xxxxxxxxxxxxxxxx>
# FEISHU_APP_SECRET=<app-secret>
# 可选：国际版 Lark 填 https://open.larksuite.com（默认 https://open.feishu.cn）
# FEISHU_DOMAIN=https://open.feishu.cn
# 可选：设为 0 关闭流式卡片（「思考中…」+ 打字机效果），改用普通 Markdown 消息回复
# FEISHU_STREAMING_CARD=1
# 可选：设为 0 可关闭日程主动提醒与晨报电台的后台扫描线程
# JARVIS_REMINDERS_ENABLED=1
# 可选：备忘与记忆数据库的存放目录，默认为项目根的 data/
# JARVIS_DATA_DIR=/path/to/data
# 可选：Heartbeat 主动唤醒——后台定期读 data/HEARTBEAT.md 关注清单，该提醒时主动开口
# 设为 0 关闭；扫描周期单位秒，默认 1800（30 分钟）
# JARVIS_HEARTBEAT_ENABLED=1
# JARVIS_HEARTBEAT_INTERVAL=1800
# 静默时段（HH:MM-HH:MM，可跨午夜；设为 off 关闭）：期间整轮跳过、不调模型；日程到点提醒不受影响。
# 24 小时内相同或高度相似的心跳只推一次（记录在 data/heartbeat-sent.json）。
# JARVIS_HEARTBEAT_QUIET_HOURS=23:00-08:00
# 可选：夜间记忆蒸馏触发时刻（HH:MM，默认 03:00）——把最近一天对话浓缩进长期画像
# JARVIS_DISTILL_TIME=03:00
# 可选：技能目录（默认项目根 skills/；放 <名>/SKILL.md 即热加载，见 skills/README.md）
# JARVIS_SKILLS_DIR=/path/to/skills
# 会议纪要邮件发送（可选）：SMTP 未配置时纪要仍会生成并保存，只是不发邮件。
# QQ 邮箱示例：host=smtp.qq.com、端口 465、密码填「设置→账户→POP3/SMTP」生成的授权码。
# JARVIS_SMTP_HOST=smtp.qq.com
# JARVIS_SMTP_PORT=465
# JARVIS_SMTP_USER=<your-mail@qq.com>
# JARVIS_SMTP_PASSWORD=<smtp-授权码，不是登录密码>
# JARVIS_SMTP_FROM=<默认同 JARVIS_SMTP_USER>
# 会议纪要默认收件邮箱（每用户可在网页「⚙ API → 桌面与会议」覆盖）
# JARVIS_MEETING_MAIL_TO=1539598168@qq.com
# 语音唤醒词匹配表（桌面端喊「贾维斯」唤醒；逗号分隔，含同音兜底）
# JARVIS_WAKE_WORDS=贾维斯,佳维斯,加维斯,家维斯,嘉维斯,jarvis
# 视觉理解模型（聊天发图/短视频，用同一个 DASHSCOPE_API_KEY；默认 qwen3-vl-flash）
# JARVIS_DASHSCOPE_VL_MODEL=qwen3-vl-flash
# 可选：日志级别（默认 WARNING；INFO 可看到心跳/提醒/蒸馏/会话清理等后台线程的记录）
# JARVIS_LOG_LEVEL=WARNING
# 可选：网页服务端口（默认 7789）
# JARVIS_PORT=7789
# 可选：Agent 专用线程池大小（默认 8，≤20 人够用）。import 时读取：生产经 systemd EnvironmentFile 注入有效，
# 本机直接跑 jarvis-web 时写在 .env 里不生效，需在启动命令的环境里设置
# JARVIS_AGENT_WORKERS=8
# 可选：每轮送模型的历史字符预算（默认 30000，按轮次边界裁剪；0 关闭裁剪）
# JARVIS_HISTORY_CHAR_BUDGET=30000
# 可选：设为 0 关闭启动时的默认/弱口令核查（只打 WARNING、不改密不锁号）
# JARVIS_WEAK_PASSWORD_SCAN=1
# 仅本机 http 调试：两项同时设置才允许不带 Secure 标记的会话 cookie（生产勿设）
# JARVIS_ENV=development
# JARVIS_ALLOW_INSECURE_COOKIE=1
